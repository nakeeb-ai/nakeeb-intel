# Nakeeb AI - Opportunity Intelligence v2.1
# .env.example - Copy to .env and fill in values
# NEVER commit .env to version control!

# === AI PROVIDERS ===
# Google Gemini (AI Studio) - Primary
# Get key: https://aistudio.google.com/apikey
# Free tier: 200 RPM, 50k TPM, 10k RPD (Gemini Decision 1)
GEMINI_API_KEY=

# OpenRouter - Fallback (free router)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face Inference API - Backup
# Get key: https://huggingface.co/settings/tokens
HF_API_KEY=

# === GITHUB ===
# Fine-grained PAT for repository_dispatch (repo: nakeeb-ai/nakeeb-intel only)
# Permissions: Contents (read/write), Actions (read), Metadata (read)
# Create: https://github.com/settings/tokens?type=beta
GH_PAT_DISPATCH=

# === TELEGRAM ===
# Bot token from @BotFather (deferred - Phase 5)
# BOT_TOKEN=
# Admin user ID (numeric)
# ADMIN_USER_ID=

# === GOOGLE DRIVE (Phase 6) ===
# rclone config generated via `rclone config`
# RCLONE_CONFIG_DRIVE_CLIENT_ID=
# RCLONE_CONFIG_DRIVE_CLIENT_SECRET=
# RCLONE_CONFIG_DRIVE_TOKEN=

# === CLOUDFLARE (Phase 5+, deferred) ===
# CF_API_TOKEN=
# CF_ACCOUNT_ID=

# === OPTIONAL ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Run ID prefix (for event correlation)
RUN_ID_PREFIX=nakeeb